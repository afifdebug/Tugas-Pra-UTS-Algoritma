import itertools
import sys
def calculate_distance(graph, path):
    distance = 0
  
    for i in range(len(path) - 1):
        distance += graph[path[i]][path[i+1]]
   
    distance += graph[path[-1]][path[0]]
    return distance
def tsp_brute_force(graph, starting_node=0):
    num_nodes = len(graph)
    nodes = list(range(num_nodes))
    nodes.remove(starting_node)
    min_path = None
    min_distance = sys.maxsize
 
    permutations = itertools.permutations(nodes)
    for perm in permutations:
        current_path = [starting_node] + list(perm)
        current_distance = calculate_distance(graph, current_path)
       
        if current_distance < min_distance:
            min_distance = current_distance
            min_path = current_path
    
    min_path.append(starting_node)
    return min_path, min_distance

